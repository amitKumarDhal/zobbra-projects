DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/zobra_db?schema=public"
PORT=5000
NODE_ENV="development"
JWT_SECRET="zobra_production_ready_jwt_secret_key_2026"
JWT_EXPIRES_IN="7d"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY="re_mock_key"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_test_secret_here"

# WhatsApp OTP customer login (WhatsApp Cloud API, server-side only — never NEXT_PUBLIC_)
# Requires an approved AUTHENTICATION template with one body variable {{1}} for the code.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE="en"
# Set to "false" if the template has no "copy code" button
WHATSAPP_OTP_TEMPLATE_COPY_BUTTON="true"
# WHATSAPP_API_VERSION="v21.0"
# Optional: dedicated secret for hashing OTPs (defaults to a key derived from JWT_SECRET)
OTP_HASH_SECRET=
# Comma-separated dial codes allowed to receive OTPs (default: 91)
OTP_ALLOWED_COUNTRY_CODES="91"
# LOCAL DEVELOPMENT ONLY: set to "console" to print OTPs to the API log instead of
# sending them (requires NODE_ENV=development; ignored in production and on Railway)
# DEV_AUTH_OTP_MODE=console

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
