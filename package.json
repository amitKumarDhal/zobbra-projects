{
  "name": "zobra-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "description": "Zobra - Modern B2B Merchandise Management SaaS Monorepo",
  "scripts": {
    "build": "turbo build",
    "build:server": "pnpm --filter zobra-server build",
    "build:web": "pnpm --filter web build",
    "start:server": "pnpm --filter zobra-server start",
    "start:web": "pnpm --filter web start",
    "dev": "turbo dev",
    "dev:local": "concurrently --kill-others --names \"web,server,api\" --prefix-colors \"cyan,green,yellow\" \"pnpm --filter web dev\" \"pnpm --filter zobra-server dev\" \"pnpm --filter @zobra/api dev\"",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "test": "turbo test",
    "test:vitest": "turbo test:vitest",
    "test:jest": "turbo test:jest",
    "test:cypress": "pnpm --filter web test:cypress",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@prisma/client": "^5.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "prisma": "^5.19.0",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
