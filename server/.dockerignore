# ═══════════════════════════════════════════════════════════════
# ZOBBRA SERVER DOCKERIGNORE - PRODUCTION BUILD & RELEASE HYGIENE
# ═══════════════════════════════════════════════════════════════

# ── 1. Environment & Secret Files (Recursive Exclusion) ───────
.env
.env.*
**/.env
**/.env.*

# Allow documentation/template example files
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# ── 2. Host Build Artifacts ────────────────────────────────────
node_modules
**/node_modules
dist
**/dist
build
**/build
.turbo
**/.turbo
*.tsbuildinfo
**/*.tsbuildinfo

# ── 3. Tests, Test Output & Coverage ───────────────────────────
coverage
**/coverage
test-results
**/test-results
tests
**/tests
**/__tests__
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# ── 4. Destructive & Dev-Only Scripts ─────────────────────────
scripts
**/scripts
src/db_audit.ts
src/**/run-security-tests.ts
src/**/payments.test.ts

# ── 5. Scratch, Temporary, Backups & Logs ──────────────────────
scratch
**/scratch
backups
**/backups
tmp
temp
*.log
**/*.log
.git
.DS_Store
